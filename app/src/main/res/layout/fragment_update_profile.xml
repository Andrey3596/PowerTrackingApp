<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Имя"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/textViewNameUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Ваше имя"
            android:inputType="text"
            android:textSize="18sp"
            android:backgroundTint="@color/elements"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пол (м/ж)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textViewGenderUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="м или ж"
            android:inputType="text"
            android:textSize="18sp"
            android:backgroundTint="@color/elements"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Возраст (лет)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textViewAgeUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Целое число"
            android:inputType="number"
            android:textSize="18sp"
            android:backgroundTint="@color/elements"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вес (кг)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textViewWeightUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Например 70.5"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:backgroundTint="@color/elements"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Рост (см)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textViewHeightUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Например 175.5"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:backgroundTint="@color/elements"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Уровень активности"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/textViewActiveUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="1.2 – 1.9"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:backgroundTint="@color/elements"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Примечание: для десятичных чисел используйте точку (например, 70.5)"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>