<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/analysis_filter_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/radioAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/filter_all" />

        <RadioButton
            android:id="@+id/radioDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/filter_day" />

        <RadioButton
            android:id="@+id/radioMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/filter_month" />

        <RadioButton
            android:id="@+id/radioYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/filter_year" />

        <RadioButton
            android:id="@+id/radioInterval"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/filter_interval" />
    </RadioGroup>

    <!-- Область параметров фильтра -->
    <LinearLayout
        android:id="@+id/layoutFilterParams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <!-- День -->
        <LinearLayout
            android:id="@+id/layoutDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/editDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/day_hint"
                android:inputType="number"
                android:minHeight="48dp" />
            <EditText
                android:id="@+id/editMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/month_hint"
                android:inputType="number"
                android:minHeight="48dp" />
            <EditText
                android:id="@+id/editYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/year_hint"
                android:inputType="number"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Месяц -->
        <LinearLayout
            android:id="@+id/layoutMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <EditText
                android:id="@+id/editMonthOnly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/month_hint"
                android:inputType="number"
                android:minHeight="48dp" />
            <EditText
                android:id="@+id/editYearForMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/year_hint"
                android:inputType="number"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Год -->
        <LinearLayout
            android:id="@+id/layoutYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <EditText
                android:id="@+id/editYearOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/year_hint"
                android:inputType="number"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Интервал -->
        <LinearLayout
            android:id="@+id/layoutInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_date_label" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/editStartDay"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/day_hint"
                    android:inputType="number"
                    android:minHeight="48dp" />
                <EditText
                    android:id="@+id/editStartMonth"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/month_hint"
                    android:inputType="number"
                    android:minHeight="48dp" />
                <EditText
                    android:id="@+id/editStartYear"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/year_hint"
                    android:inputType="number"
                    android:minHeight="48dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/end_date_label"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/editEndDay"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/day_hint"
                    android:inputType="number"
                    android:minHeight="48dp" />
                <EditText
                    android:id="@+id/editEndMonth"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/month_hint"
                    android:inputType="number"
                    android:minHeight="48dp" />
                <EditText
                    android:id="@+id/editEndYear"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/year_hint"
                    android:inputType="number"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/buttonApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apply_filter_button"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/elements"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewAnalysis"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textViewSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/elements"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutBackForward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/elements"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/back" />
        <Button
            android:id="@+id/buttonForward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/elements"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/forward" />
    </LinearLayout>



    <!-- Нижняя панель навигации (убраны лишние app:constraint атрибуты) -->
    <include
        android:id="@+id/bottomNavLayout"
        layout="@layout/bottom_nav_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>