<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp"
    tools:context=".RegistrationActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonReg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textViewReg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reg"
                android:textSize="40sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="32dp" />

            <!-- Поле Имя + кнопка подсказки -->
            <EditText
                android:id="@+id/editTextName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/TextName"
                android:inputType="text"
                android:minHeight="48dp"
                android:backgroundTint="@color/elements"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@+id/textViewReg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonHintName" />

            <Button
                android:id="@+id/buttonHintName"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/buthint"
                android:textSize="26sp"
                android:gravity="center"
                android:backgroundTint="@color/elements"
                android:padding="0dp"
                app:layout_constraintTop_toTopOf="@+id/editTextName"
                app:layout_constraintBottom_toBottomOf="@+id/editTextName"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp" />

            <!-- Поле Пол -->
            <EditText
                android:id="@+id/editTextGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/TextGender"
                android:inputType="text"
                android:minHeight="48dp"
                android:backgroundTint="@color/elements"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/editTextName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonHintGender" />

            <Button
                android:id="@+id/buttonHintGender"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/buthint"
                android:textSize="26sp"
                android:gravity="center"
                android:backgroundTint="@color/elements"
                android:padding="0dp"
                app:layout_constraintTop_toTopOf="@+id/editTextGender"
                app:layout_constraintBottom_toBottomOf="@+id/editTextGender"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp" />

            <!-- Поле Возраст -->
            <EditText
                android:id="@+id/editTextAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/TextAge"
                android:inputType="number"
                android:minHeight="48dp"
                android:backgroundTint="@color/elements"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/editTextGender"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonHintAge" />

            <Button
                android:id="@+id/buttonHintAge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/buthint"
                android:textSize="26sp"
                android:gravity="center"
                android:backgroundTint="@color/elements"
                android:padding="0dp"
                app:layout_constraintTop_toTopOf="@+id/editTextAge"
                app:layout_constraintBottom_toBottomOf="@+id/editTextAge"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp" />

            <!-- Поле Вес -->
            <EditText
                android:id="@+id/editTextWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/TextWeight"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:backgroundTint="@color/elements"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/editTextAge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonHintWeight" />

            <Button
                android:id="@+id/buttonHintWeight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/buthint"
                android:textSize="26sp"
                android:gravity="center"
                android:backgroundTint="@color/elements"
                android:padding="0dp"
                app:layout_constraintTop_toTopOf="@+id/editTextWeight"
                app:layout_constraintBottom_toBottomOf="@+id/editTextWeight"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp" />

            <!-- Поле Рост -->
            <EditText
                android:id="@+id/editTextHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/TextHeight"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:backgroundTint="@color/elements"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/editTextWeight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonHintHeight" />

            <Button
                android:id="@+id/buttonHintHeight"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/buthint"
                android:textSize="26sp"
                android:gravity="center"
                android:backgroundTint="@color/elements"
                android:padding="0dp"
                app:layout_constraintTop_toTopOf="@+id/editTextHeight"
                app:layout_constraintBottom_toBottomOf="@+id/editTextHeight"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp" />

            <!-- Поле Активность -->
            <EditText
                android:id="@+id/editTextActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/TextActive"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:backgroundTint="@color/elements"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/editTextHeight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonHintActive" />

            <Button
                android:id="@+id/buttonHintActive"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="@string/buthint"
                android:textSize="26sp"
                android:gravity="center"
                android:backgroundTint="@color/elements"
                android:padding="0dp"
                app:layout_constraintTop_toTopOf="@+id/editTextActive"
                app:layout_constraintBottom_toBottomOf="@+id/editTextActive"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="8dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Кнопка регистрации привязана к низу -->
    <Button
        android:id="@+id/buttonReg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/butReg"
        android:backgroundTint="@color/elements"
        android:onClick="registration"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>